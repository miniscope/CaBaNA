{
 "pipeline": {
  "transforms": [
   {
    "name": "interpolate_gaps",
    "signal": [
     "x",
     "y"
    ],
    "max_gap_s": 0.5
   },
   {
    "name": "smooth_signal",
    "signal": [
     "x",
     "y"
    ],
    "method": "median",
    "window_s": 0.25
   },
   {
    "name": "speed",
    "signals": [
     "x",
     "y"
    ],
    "window_s": 0.25
   },
   {
    "name": "bouts_to_states",
    "source": "social_epochs",
    "behaviors": [
     "follow",
     "sniff_anogenital",
     "sniff_face"
    ],
    "exclusive": false,
    "output": "auroc_target"
   }
  ],
  "preprocess": [
   {
    "name": "smooth_activity",
    "sigma_s": 0.1
   },
   {
    "name": "speed_threshold",
    "signal": "speed",
    "min_speed": 2
   }
  ],
  "selectors": [],
  "analyses": [
   {
    "name": "auroc",
    "metric": {
     "name": "auroc",
     "min_frames": 20
    },
    "states": "auroc_target",
    "shuffle": {
     "n_shuffles": 1000,
     "null": {
      "name": "covariate_matched_shift",
      "min_shift_s": 20,
      "covariate": "speed",
      "statistic": "ks",
      "tolerance": 0.1,
      "max_tries": 20,
      "min_frames": 50
     },
     "min_shift_s": 20,
     "seed": 0,
     "alpha": 0.05,
     "correction": "max_stat",
     "correction_scope": "states",
     "n_jobs": -1
    }
   }
  ]
 },
 "problems": []
}
