{
 "session": "simulated_social_interaction",
 "pipeline": {
  "analyses": [
   {
    "name": "pca",
    "metric": {
     "name": "pca_population",
     "n_components": 10,
     "zscore": true,
     "distance": "euclidean",
     "min_frames": 20
    },
    "states": "social",
    "shuffle": {
     "n_shuffles": 50,
     "null": {
      "name": "cell_shift",
      "min_shift_s": 20.0,
      "min_pair_separation_s": 1.0
     },
     "seed": 0,
     "alpha": 0.05,
     "correction": "none",
     "n_jobs": -1
    }
   }
  ],
  "preprocess": [
   {
    "name": "rebin_time",
    "bin_s": 0.5,
    "activity_method": "auto",
    "min_fraction": 0.5
   }
  ]
 }
}