{
 "session": "simulated_open_field",
 "pipeline": {
  "transforms": [
   {
    "name": "speed",
    "signals": [
     "x",
     "y"
    ],
    "window_s": 0.5
   },
   {
    "name": "bin_grid",
    "signals": [
     "x",
     "y"
    ],
    "bin_size": 3.0,
    "output": "position"
   }
  ],
  "preprocess": [
   {
    "name": "speed_threshold",
    "signal": "speed",
    "min_speed": 2.0,
    "output": "speed"
   }
  ],
  "analyses": [
   {
    "name": "information",
    "metric": {
     "name": "information_content",
     "units": "bits_per_event",
     "weight": "amplitude",
     "min_occupancy_s": 0.05,
     "smooth_sigma_bins": 0.0
    },
    "states": "position",
    "signal": null,
    "shuffle": {
     "n_shuffles": 50,
     "null": null,
     "min_shift_s": 20.0,
     "seed": 0,
     "derive_seeds": true,
     "alpha": 0.05,
     "tail": null,
     "batch_size": 100,
     "n_jobs": 1,
     "keep_null": "full",
     "max_null_bytes": 1073741824,
     "null_dtype": "float64",
     "correction": "none",
     "correction_scope": "states"
    },
    "masks": [
     "speed"
    ]
   },
   {
    "name": "stability",
    "metric": {
     "name": "split_half_stability",
     "n_blocks": 2,
     "min_occupancy_s": 0.05,
     "smooth_sigma_bins": 0.0
    },
    "states": "position",
    "signal": null,
    "shuffle": {
     "n_shuffles": 50,
     "null": null,
     "min_shift_s": 20.0,
     "seed": 0,
     "derive_seeds": true,
     "alpha": 0.05,
     "tail": null,
     "batch_size": 100,
     "n_jobs": 1,
     "keep_null": "full",
     "max_null_bytes": 1073741824,
     "null_dtype": "float64",
     "correction": "none",
     "correction_scope": "states"
    },
    "masks": [
     "speed"
    ]
   },
   {
    "name": "fields",
    "metric": {
     "name": "place_fields",
     "smooth_sigma_bins": 1.0,
     "min_occupancy_s": 0.1,
     "threshold": 0.5,
     "threshold_mode": "peak_fraction",
     "min_field_bins": 2,
     "connectivity": 1,
     "statistic": "in_out_ratio"
    },
    "states": "position",
    "signal": null,
    "shuffle": {
     "n_shuffles": 50,
     "null": null,
     "min_shift_s": 20.0,
     "seed": 0,
     "derive_seeds": true,
     "alpha": 0.05,
     "tail": null,
     "batch_size": 100,
     "n_jobs": 1,
     "keep_null": "full",
     "max_null_bytes": 1073741824,
     "null_dtype": "float64",
     "correction": "none",
     "correction_scope": "states"
    },
    "masks": [
     "speed"
    ]
   }
  ],
  "selectors": [
   {
    "name": "auto_smooth_sigma",
    "states": "position",
    "analyses": "*",
    "candidates_mm": null,
    "candidates_bins": null,
    "n_folds": 5,
    "likelihood": "poisson",
    "one_se": true,
    "min_occupancy_s": 0.05,
    "masks": null,
    "pool": "population"
   },
   {
    "name": "auto_null_timescale",
    "analyses": "*",
    "multiple": 3.0,
    "min_shift_floor_s": 5.0,
    "max_fraction": 0.25,
    "block_rule": "autocorr",
    "block_floor_s": 0.25,
    "max_lag_s": 60.0,
    "set_min_shift": true,
    "set_block": true
   }
  ]
 }
}