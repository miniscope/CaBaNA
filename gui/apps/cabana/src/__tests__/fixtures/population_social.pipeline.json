{
 "session": "simulated_social_interaction",
 "pipeline": {
  "preprocess": [
   {
    "name": "rebin_time",
    "bin_s": 0.5,
    "activity_method": "auto",
    "min_fraction": 0.5
   }
  ],
  "analyses": [
   {
    "name": "pv_similarity",
    "metric": {
     "name": "population_vector_overlap",
     "similarity": "cosine",
     "min_occupancy_s": 0.05,
     "normalize_cells": true
    },
    "states": "social",
    "shuffle": {
     "n_shuffles": 50,
     "null": {
      "name": "cell_shift",
      "min_shift_s": 20.0,
      "min_pair_separation_s": 1.0
     },
     "seed": 0,
     "alpha": 0.05,
     "correction": "none",
     "n_jobs": -1
    }
   },
   {
    "name": "pv_stability",
    "metric": {
     "name": "pv_stability",
     "n_blocks": 2,
     "min_occupancy_s": 0.05
    },
    "states": "social",
    "shuffle": {
     "n_shuffles": 50,
     "null": {
      "name": "cell_shift",
      "min_shift_s": 20.0,
      "min_pair_separation_s": 1.0
     },
     "seed": 0,
     "alpha": 0.05,
     "correction": "none",
     "n_jobs": -1
    }
   },
   {
    "name": "state_separation",
    "metric": {
     "name": "pca_population",
     "n_components": 10,
     "zscore": true,
     "distance": "euclidean",
     "min_frames": 20
    },
    "states": "social",
    "shuffle": {
     "n_shuffles": 50,
     "null": {
      "name": "cell_shift",
      "min_shift_s": 20.0,
      "min_pair_separation_s": 1.0
     },
     "seed": 0,
     "alpha": 0.05,
     "correction": "none",
     "n_jobs": -1
    }
   },
   {
    "name": "dimensionality",
    "metric": {
     "name": "participation_ratio",
     "zscore": true,
     "min_frames": 50,
     "per_state": false
    },
    "states": "social",
    "shuffle": {
     "n_shuffles": 50,
     "null": {
      "name": "cell_shift",
      "min_shift_s": 20.0,
      "min_pair_separation_s": 1.0
     },
     "seed": 0,
     "alpha": 0.05,
     "correction": "none",
     "n_jobs": -1
    }
   },
   {
    "name": "pairwise",
    "metric": {
     "name": "pairwise_correlation",
     "kind": "total",
     "method": "pearson",
     "min_frames": 50,
     "zscore": true
    },
    "states": "social"
   }
  ]
 }
}