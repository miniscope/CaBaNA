{
  "name": "cabana-gui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/cabana",
    "build": "npm run build -w apps/cabana",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -p apps/cabana --noEmit",
    "lint": "eslint apps/ packages/",
    "format": "prettier --write apps packages"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.12.0",
    "eslint-plugin-solid": "^0.18.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vite-plugin-solid": "^2.11.14",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.3"
  }
}
